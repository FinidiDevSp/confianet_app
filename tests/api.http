@baseUrl = http://localhost:8000

### Salud del servicio (API y DB)
GET {{baseUrl}}/api/health

### Swagger Docs (referencia)
GET {{baseUrl}}/docs

@email = admin@example.com
@password = 123456

### Login (happy path)
# @name login
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}
> {%
// Guarda access_token y cookie de refresh para siguientes requests
try {
  const data = JSON.parse(response.body);
  if (data && data.access_token) {
    client.global.set("accessToken", data.access_token);
  }
} catch {}
const setCookie = response.headers["set-cookie"]; // puede ser string o array
const cookies = Array.isArray(setCookie) ? setCookie : (setCookie ? [setCookie] : []);
for (const c of cookies) {
  const m = /refresh_token=([^;]+)/.exec(c);
  if (m) {
    client.global.set("refreshCookie", `refresh_token=${m[1]}`);
  }
}
%}

### Login (credenciales inválidas -> 401)
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "wrong"
}

### Login (usuario suspendido -> 403)
# Ajusta el email a uno suspendido en tu base de datos
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "suspendido@example.com",
  "password": "{{password}}"
}

### Me sin token (debe 401)
GET {{baseUrl}}/api/auth/me

### Me con token (usa accessToken capturado)
GET {{baseUrl}}/api/auth/me
Authorization: Bearer {{accessToken}}

### MFA: iniciar configuración (requiere token)
POST {{baseUrl}}/api/users/mfa/setup/start
Authorization: Bearer {{accessToken}}

### MFA: confirmar configuración (reemplaza SECRET y CODE por los correctos)
POST {{baseUrl}}/api/users/mfa/setup/confirm
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "secret": "REEMPLAZA_SECRET",
  "code": "123456"
}

### Login con 2FA habilitado (respuesta requiere MFA)
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

### MFA: verificar código tras login
# Copia el mfa_token de la respuesta previa
POST {{baseUrl}}/api/auth/mfa/verify
Content-Type: application/json

{
  "mfa_token": "REEMPLAZA_MFA_TOKEN",
  "code": "123456"
}

### MFA: deshabilitar (usa code o recovery_code)
POST {{baseUrl}}/api/users/mfa/disable
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "recovery_code": "REEMPLAZA_RECOVERY"
}

### Impersonate: iniciar (admin)
POST {{baseUrl}}/api/auth/impersonate/start
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "target_user_id": "REEMPLAZA_USER_ID"
}

### Impersonate: terminar (usa token de impersonación en Authorization)
POST {{baseUrl}}/api/auth/impersonate/stop
Authorization: Bearer REEMPLAZA_IMP_TOKEN

### Refresh (requiere cookie HttpOnly)
# Usa la cookie capturada del login: {{refreshCookie}}
POST {{baseUrl}}/api/auth/refresh
Cookie: {{refreshCookie}}

### Refresh actualiza cookie (captura nueva)
# @name refresh_capture
POST {{baseUrl}}/api/auth/refresh
Cookie: {{refreshCookie}}
> {%
const setCookie = response.headers["set-cookie"]; 
const cookies = Array.isArray(setCookie) ? setCookie : (setCookie ? [setCookie] : []);
for (const c of cookies) {
  const m = /refresh_token=([^;]+)/.exec(c);
  if (m) {
    client.global.set("refreshCookie", `refresh_token=${m[1]}`);
  }
}
%}

### Logout (borra cookie refresh)
POST {{baseUrl}}/api/auth/logout

### Login simple (sin handler) para diagnosticar
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

### Audit: listar logs (requiere token)
GET {{baseUrl}}/api/audit/logs?limit=10
Authorization: Bearer {{accessToken}}

### Audit: stats por acción (requiere token)
GET {{baseUrl}}/api/audit/stats
Authorization: Bearer {{accessToken}}

### Audit: listar logs filtrando por acción (login_success)
GET {{baseUrl}}/api/audit/logs?limit=10&action=login_success
Authorization: Bearer {{accessToken}}

### Audit: listar logs filtrando por rol (admin)
GET {{baseUrl}}/api/audit/logs?limit=10&role=admin
Authorization: Bearer {{accessToken}}

### Users: invitar usuario (admin)
POST {{baseUrl}}/api/users/invitations
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "email": "nuevo.investigador@example.com",
  "name": "Investigador Demo",
  "role": "investigador",
  "mfa": true
}

### Settings: obtener configuración de correo (admin)
GET {{baseUrl}}/api/settings/email
Authorization: Bearer {{accessToken}}

### Settings: configurar SMTP (admin)
PATCH {{baseUrl}}/api/settings/email
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "smtp_host": "smtp.example.com",
  "smtp_port": 587,
  "username": "apikey",
  "password": "REEMPLAZA",
  "use_tls": true,
  "use_ssl": false,
  "from_name": "Confianet",
  "from_email": "no-reply@example.com"
}

### Users: listar usuarios (admin)
GET {{baseUrl}}/api/users?limit=10&offset=0
Authorization: Bearer {{accessToken}}

### Users: listar usuarios (página 2)
GET {{baseUrl}}/api/users?limit=10&offset=10
Authorization: Bearer {{accessToken}}

### Users: actualizar nombre y rol (happy path)
# Ajusta {user_id} a un ID existente devuelto por el listado
PATCH {{baseUrl}}/api/users/{user_id}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "Nombre Actualizado",
  "role": "responsable"
}

### Users: suspender usuario (happy path)
# Ajusta {user_id} a un ID existente
POST {{baseUrl}}/api/users/{user_id}/suspend
Authorization: Bearer {{accessToken}}

### Users: eliminar usuario (happy path)
# Ajusta {user_id} a un ID existente (usa un usuario de pruebas)
DELETE {{baseUrl}}/api/users/{user_id}
Authorization: Bearer {{accessToken}}

### Users: reenviar invitación si pending (si no caducó, reutiliza)
# Ajusta {user_id} de un usuario con estado pending
POST {{baseUrl}}/api/users/{user_id}/resend-invitation
Authorization: Bearer {{accessToken}}

### Users: reenviar invitación para usuario activo (debe 400)
POST {{baseUrl}}/api/users/{active_user_id}/resend-invitation
Authorization: Bearer {{accessToken}}

### Users: password policy (get)
GET {{baseUrl}}/api/users/password-policy
Authorization: Bearer {{accessToken}}

### Users: password policy (set)
PATCH {{baseUrl}}/api/users/password-policy
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "min_length": 12,
  "require_upper": true,
  "require_number": true,
  "require_symbol": true
}

### Users: validar invitación (token de ejemplo)
GET {{baseUrl}}/api/users/invitations/validate?token=REEMPLAZA_TOKEN


